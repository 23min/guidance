#!/bin/sh
# Join rules/*.md, in file-name order, into AGENTS.md for hosts that read a single
# instruction file (Codex). The file is replaced whole, never left half-written.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
tmp=$(mktemp "$root/.AGENTS.md.XXXXXX")
trap 'rm -f "$tmp"' EXIT
{
  printf '<!-- Generated by ~/.guidance/build from rules/*.md. Edit the rules, not this file. -->\n'
  for rule in "$root"/rules/*.md; do
    [ -f "$rule" ] || continue
    printf '\n'
    cat "$rule"
  done
} > "$tmp"
chmod 644 "$tmp"
mv "$tmp" "$root/AGENTS.md"
trap - EXIT
